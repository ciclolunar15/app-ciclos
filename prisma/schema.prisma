// Modelo de datos de Maresa.
// Prisma 7: el generador es "prisma-client" (el antiguo "prisma-client-js" está obsoleto)
// y la URL del datasource se resuelve en prisma.config.ts, no aquí.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Perfil de la usuaria. El id es el userId de Clerk: así evitamos una tabla
/// de mapeo y la fila se crea de forma perezosa la primera vez que entra.
model User {
  id         String     @id
  hemisphere Hemisphere @default(NORTHERN)
  timezone   String     @default("Europe/Madrid")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  /// Última fase (folicular/ovulatoria/lutea) por la que ya se avisó, para
  /// que el cron de recordatorios (api/cron/recordatorios) no repita el
  /// mismo push todos los días mientras dure la fase.
  notificacionFaseCiclo String?
  /// Fecha de "próximo período" para la que ya se mandó el aviso "se acerca".
  notificacionPeriodoProximo DateTime? @db.Date
  /// Fecha de "próximo período" para la que ya se mandó el aviso "es hoy".
  notificacionPeriodoHoy     DateTime? @db.Date

  /// Intentos fallidos al canjear un código de acceso. Al llegar al límite
  /// (ver LIMITE_INTENTOS en lib/dal/acceso.ts) se bloquea el canje — hoy no
  /// hay forma de resetearlo desde la UI, solo a mano en la base.
  intentosCodigoFallidos Int @default(0)

  cycles              Cycle[]
  postsForo           PostForo[]
  pushSubscriptions   PushSubscription[]
  codigosAccesoUsados CodigoAcceso[]
}

/// Un periodo registrado. startDate es el primer día de sangrado y es
/// la fecha sobre la que se calcula todo lo demás.
model Cycle {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// @db.Date y no DateTime completo: un ciclo se registra en días naturales.
  /// Guardar la hora provocaría que un periodo anotado a las 23:00 en Madrid
  /// se almacenase como el día anterior en UTC.
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Impide registrar dos veces el mismo inicio de periodo.
  @@unique([userId, startDate])
  @@index([userId, startDate])
}

enum Hemisphere {
  NORTHERN
  SOUTHERN
}

/// Consejo de bienestar cargado por la administradora, ligado a una
/// combinación de fase del ciclo + fase lunar. Contenido curado a mano, no
/// generado por la app — ver lib/dal/consejos.ts.
model Consejo {
  id        String           @id @default(cuid())
  faseCiclo FaseCicloConsejo
  faseLunar FaseLunarConsejo
  texto     String
  /// userId (Clerk) de la administradora que lo cargó.
  creadoPor String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([faseCiclo, faseLunar])
}

enum FaseCicloConsejo {
  MENSTRUAL
  PRE_OVULACION
  OVULACION
  PRE_MENSTRUAL
}

enum FaseLunarConsejo {
  NUEVA
  CRECIENTE
  LLENA
  MENGUANTE
}

/// Post del foro comunitario. userId siempre identifica a la autora real
/// (para poder borrar/moderar), aunque esAnonimo haga que no se muestre.
///
/// Los hilos son de un solo nivel a propósito: responder a una respuesta
/// cuelga del mismo hilo raíz en vez de anidar más (ver crearPost en
/// lib/dal/foro.ts) — "se sigue sobre el mismo hilo", no un árbol infinito.
model PostForo {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contenido    String
  esAnonimo    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  respuestaAId String?
  respuestaA   PostForo?  @relation("Respuestas", fields: [respuestaAId], references: [id], onDelete: Cascade)
  respuestas   PostForo[] @relation("Respuestas")

  @@index([createdAt])
  @@index([respuestaAId])
}

/// Suscripción push de un dispositivo (una usuaria puede tener varias: el
/// celular, la compu, etc.). Genérico a propósito, no es solo del foro — sirve
/// de base para los recordatorios de ciclo que vengan después.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

/// Código de único uso para el acceso pago. Solo el más reciente sin usar
/// (usadoPorId: null, el de mayor createdAt) es "vigente" — no hace falta
/// invalidar los viejos a mano, ver canjearCodigo() en lib/dal/acceso.ts.
/// El acceso que otorga es permanente: generar uno nuevo no le quita el
/// acceso a quien ya canjeó uno anterior.
model CodigoAcceso {
  id         String    @id @default(cuid())
  codigo     String    @unique
  /// userId (Clerk) de la administradora que lo generó.
  creadoPor  String
  createdAt  DateTime  @default(now())
  usadoPorId String?
  usadoPor   User?     @relation(fields: [usadoPorId], references: [id], onDelete: SetNull)
  usadoEn    DateTime?
}
